# Binance USDT-M Futures credentials. Required only for live trading.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_RECV_WINDOW=5000

# Strategy parameters
TRADE_NOTIONAL_USDT=1000
LEVERAGE=5
MARGIN_MODE=ISOLATED
TIMEFRAME_MINUTES=15
BUY_THRESHOLD_PERCENT=5.0
SELL_THRESHOLD_PERCENT=-5.0
TOGGLE_PERCENT=0.001
PRICE_CHECK_INTERVAL_MS=1000
MAX_GLOBAL_OPEN_TRADES=1

# Safety: dry-run by default. Real orders require both lines below plus credentials.
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_IS_LIVE
